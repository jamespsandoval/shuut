{
  "expo": {
    "name": "SHÜÜT",
    "slug": "shuut-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shuut-native",
    "userInterfaceStyle": "light",
    "extra": {
      "EXPO_PUBLIC_API_BASE_URL": "https://shuut.me"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.shuut",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SHÜÜT uses the microphone only when you choose to record a voice post or comment, and lets you review it before publishing.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "SHÜÜT uses the microphone only when you choose to record a voice post or comment, and lets you review it before publishing.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SHÜÜT uses your photo library when you choose a profile image or attach a photo to a voice post or reSHÜÜT.",
          "cameraPermission": "SHÜÜT uses the camera only when you choose to take a photo for a voice post or reSHÜÜT.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FA"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
