{
  "expo": {
    "name": "SHÜÜT",
    "slug": "shuut-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shuut-native",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doubleportrait.shuut",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SHÜÜT uses the microphone only when you choose to record a voice post or comment, and lets you review it before publishing."
      }
    },
    "android": {
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "SHÜÜT uses the microphone only when you choose to record a voice post or comment, and lets you review it before publishing.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
